---
import { site } from '../data/site.js';

const embed = site.newsletterEmbedUrl;
---

<section class="container section">
  <div class="newsletter">
    <h2>Get the week in AI, <span class="gradient-text">in five minutes</span></h2>
    {embed ? (
      <>
        <p class="muted">A weekly email with the biggest AI news, one tool worth trying, and one practical tip. Free, and you can unsubscribe any time.</p>
        <iframe src={embed} title="Newsletter signup" loading="lazy" class="signup"></iframe>
        <p class="fine muted">By subscribing you agree to our <a href="/privacy/">privacy policy</a>.</p>
      </>
    ) : (
      <>
        <p class="muted">
          A weekly email with the biggest AI news, one tool worth trying, and one practical tip. The newsletter is launching soon.
        </p>
        <a href="/contact/" class="btn primary">Ask to be notified</a>
      </>
    )}
  </div>
</section>

<style>
  .newsletter {
    text-align: center;
    padding: 48px 24px;
    border-radius: 24px;
    border: 1px solid var(--border);
    background:
      radial-gradient(circle at 20% 0%, rgba(34, 211, 238, 0.15), transparent 50%),
      radial-gradient(circle at 80% 100%, rgba(167, 139, 250, 0.15), transparent 50%),
      var(--surface);
  }
  p { max-width: 560px; margin: 0 auto 24px; }
  .signup {
    display: block;
    width: 100%;
    max-width: 480px;
    height: 150px;
    margin: 0 auto;
    border: 0;
    border-radius: 12px;
    background: transparent;
  }
  .fine { font-size: 0.8rem; margin: 12px auto 0; }
</style>
