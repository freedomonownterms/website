---
const links = [
  { href: '/news/', label: 'News' },
  { href: '/tools/', label: 'Tools' },
  { href: '/guides/', label: 'Guides' },
  { href: '/prompts/', label: 'Prompts' },
  { href: '/weather/', label: 'Weather' },
  { href: '/shop/', label: 'Shop' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="logo" aria-label="Freedom On Own Terms home">
      <span class="mark">
        <img src="/logo.svg?v=4" alt="" width="40" height="40" />
        <sup class="tm" title="Trademark">™</sup>
      </span>
      <span>Freedom <span class="gradient-text">On Own Terms</span></span>
    </a>
    <button class="menu-btn" aria-label="Toggle menu" aria-expanded="false" aria-controls="site-nav">
      <span></span><span></span><span></span>
    </button>
    <nav id="site-nav">
      {links.map((l) => (
        <a href={l.href} class={path.startsWith(l.href) ? 'active' : ''}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector('.menu-btn');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10, 11, 16, 0.8);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .logo:hover { text-decoration: none; }
  .mark { position: relative; display: inline-flex; }
  .tm {
    position: absolute;
    top: -2px;
    right: -9px;
    font-family: var(--font-body, inherit);
    font-size: 0.55rem;
    font-weight: 500;
    line-height: 1;
    color: var(--muted);
  }
  nav { display: flex; gap: 6px; }
  nav a {
    color: var(--muted);
    padding: 8px 14px;
    border-radius: 999px;
    font-weight: 500;
  }
  nav a:hover { color: var(--text); text-decoration: none; background: var(--surface); }
  nav a.active { color: var(--text); background: var(--surface-2); }
  .menu-btn {
    display: none;
    background: none;
    border: 0;
    padding: 8px;
    cursor: pointer;
    flex-direction: column;
    gap: 5px;
  }
  .menu-btn span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
  }
  @media (max-width: 760px) {
    .menu-btn { display: flex; }
    nav {
      display: none;
      position: absolute;
      top: 68px;
      left: 0;
      right: 0;
      flex-direction: column;
      padding: 12px 16px 20px;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }
    nav.open { display: flex; }
  }
</style>
