---
import Base from '../../layouts/Base.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { getGuides, getRelated, getToolLink, formatDate } from '../../lib/guides.js';

export function getStaticPaths() {
  return getGuides().map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content } = guide;
const related = getRelated(guide);
const tool = getToolLink(guide);
---

<Base title={guide.title} description={guide.description} type="article" published={guide.date} ogImage={`/og/${guide.slug}.png`}>
  <article class="container">
    <header class="page-head">
      <a href="/guides/" class="back">← All guides</a>
      <span class="chip violet">{guide.category}</span>
      <h1>{guide.title}</h1>
      <p>{guide.description}</p>
      <span class="muted small">{formatDate(guide.date)} · {guide.readTime}</span>
    </header>
    <div class="prose">
      <Content />
    </div>
    <div class="after">
      <p class="tool"><a href={tool.href}>{tool.label} →</a></p>
      <ShareButtons title={guide.title} label="Found this useful? Share it" />
      <h2>Related guides</h2>
      <ul class="related">
        {related.map((g) => (
          <li><a href={`/guides/${g.slug}/`}>{g.title}</a> <span class="muted small">{g.readTime}</span></li>
        ))}
      </ul>
    </div>
  </article>
</Base>

<style>
  .back { display: block; margin-bottom: 20px; font-size: 0.9rem; }
  h1 { margin-top: 16px; max-width: 820px; }
  .small { font-size: 0.9rem; }
  .after { max-width: 720px; }
  .tool { margin: 36px 0 0; font-size: 1.08rem; font-weight: 600; }
  .after h2 { font-size: 1.25rem; margin: 0 0 10px; }
  .related { list-style: none; margin: 0; padding: 0; }
  .related li { padding: 10px 0; border-bottom: 1px solid var(--border); }
  .related a { color: var(--text); font-weight: 600; }
  .related a:hover { color: var(--accent); }
</style>
